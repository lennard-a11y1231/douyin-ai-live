# 复制成 .env 再填自己的 key
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 小米 MiMo 语音合成：https://platform.xiaomimimo.com 控制台拿 key
MIMO_API_KEY=sk-你的key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TIMEOUT=20

# 默认音色
# MiMo：mimo_soda(男) / mimo_ice(女) / mimo_jasmine(女) / mimo_birch(男)
# 系统：tingting / flo / sandy / meijia
VOICE_PRESET=mimo_soda
